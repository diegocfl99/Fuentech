    <!-- FORMULARIO DE CONTACTO -->
    <script>
            document.addEventListener("DOMContentLoaded", function () {

                const form = document.getElementById("contactForm");
                const email = document.getElementById("contactEmail");
                const phone = document.getElementById("contactPhone");
                const error = document.getElementById("contactError");
                const status = document.getElementById("formStatus");
                const submitButton = form.querySelector(".form-submit");

                function limpiarError() {
                    error.classList.remove("visible");
                    email.removeAttribute("aria-invalid");
                    phone.removeAttribute("aria-invalid");
                }

                email.addEventListener("input", limpiarError);
                phone.addEventListener("input", limpiarError);

                form.addEventListener("submit", async function (event) {

                    event.preventDefault();

                    limpiarError();
                    status.classList.remove("visible");

                    const correoIngresado = email.value.trim();
                    const telefonoIngresado = phone.value.trim();

                    // Al menos un medio de contacto es obligatorio.
                    if (!correoIngresado && !telefonoIngresado) {

                        error.classList.add("visible");

                        email.setAttribute("aria-invalid", "true");
                        phone.setAttribute("aria-invalid", "true");

                        email.focus();
                        return;
                    }

                    // Validar los campos del formulario.
                    if (!form.checkValidity()) {
                        form.reportValidity();
                        return;
                    }

                    // Evitar envíos repetidos.
                    submitButton.disabled = true;
                    submitButton.innerHTML = "Enviando...";

                    try {

                        const formData = new FormData(form);

                        const response = await fetch("?handler=Solicitud", {
                            method: "POST",
                            body: formData
                        });

                        const resultado = await response.json();

                        status.textContent = resultado.mensaje;
                        status.classList.add("visible");

                        if (response.ok && resultado.success) {

                            // Limpiar el formulario si se guardó correctamente.
                            form.reset();
                            limpiarError();

                        }

                    } catch (err) {

                        status.textContent =
                            "Ocurrió un error al enviar tu solicitud. Intenta nuevamente.";

                        status.classList.add("visible");

                    } finally {

                        submitButton.disabled = false;
                        submitButton.innerHTML = 'Enviar solicitud <span>→</span>';

                    }

                });

            });
    </script>


    <!-- FUNCIONALIDAD DEL CHATBOT FUENTECH -->
    <script>
            document.addEventListener("DOMContentLoaded", function () {

                const launcher = document.getElementById("fcChatLauncher");
                const panel = document.getElementById("fcChatPanel");
                const closeButton = document.getElementById("fcChatClose");
                const chatForm = document.getElementById("fcChatForm");
                const chatInput = document.getElementById("fcChatInput");
                const sendButton = document.getElementById("fcChatSend");
                const messages = document.getElementById("fcChatMessages");

                // Abrir y cerrar la ventana del chatbot.
                function abrirChat() {
                    panel.classList.add("open");
                    panel.setAttribute("aria-hidden", "false");
                    launcher.setAttribute("aria-expanded", "true");
                    chatInput.focus();
                }

                function cerrarChat() {
                    panel.classList.remove("open");
                    panel.setAttribute("aria-hidden", "true");
                    launcher.setAttribute("aria-expanded", "false");
                    launcher.focus();
                }

                launcher.addEventListener("click", function () {
                    if (panel.classList.contains("open")) {
                        cerrarChat();
                    } else {
                        abrirChat();
                    }
                });

                closeButton.addEventListener("click", cerrarChat);

                document.addEventListener("keydown", function (event) {
                    if (event.key === "Escape" && panel.classList.contains("open")) {
                        cerrarChat();
                    }
                });

                // Agrega mensajes sin interpretar el texto como HTML.
                function agregarMensaje(texto, tipo) {
                    const message = document.createElement("div");
                    message.className = "fc-message " + tipo;

                    const bubble = document.createElement("div");
                    bubble.className = "fc-bubble";
                    bubble.textContent = texto;

                    message.appendChild(bubble);
                    messages.appendChild(message);
                    messages.scrollTop = messages.scrollHeight;

                    return message;
                }

                // Envía el mensaje a Razor Pages, que se comunica con Ollama.
                chatForm.addEventListener("submit", async function (event) {
                    event.preventDefault();

                    const mensaje = chatInput.value.trim();
                    if (!mensaje || sendButton.disabled) {
                        return;
                    }

                    agregarMensaje(mensaje, "user");
                    chatInput.value = "";
                    sendButton.disabled = true;
                    chatInput.disabled = true;

                    const typingMessage = agregarMensaje(
                        "Estoy preparando una respuesta...",
                        "assistant"
                    );

                    try {
                        // FormData incluye el token antifalsificación oculto del formulario.
                        const formData = new FormData(chatForm);
                        formData.set("mensaje", mensaje);

                        const response = await fetch(
                            window.location.pathname + "?handler=Chat",
                            {
                                method: "POST",
                                body: formData,
                                headers: {
                                    "X-Requested-With": "XMLHttpRequest"
                                }
                            }
                        );

                        let data;

                        try {
                            data = await response.json();
                        } catch {
                            throw new Error(
                                "El servidor no devolvió una respuesta válida. Recarga la página e intenta nuevamente."
                            );
                        }

                        if (!response.ok || !data.success) {
                            throw new Error(
                                data.respuesta || "No fue posible obtener una respuesta. Intenta nuevamente."
                            );
                        }

                        typingMessage.remove();
                        agregarMensaje(
                            data.respuesta || "No recibí contenido en la respuesta.",
                            "assistant"
                        );
                    }
                    catch (error) {
                        typingMessage.remove();
                        agregarMensaje(
                            error.message || "Ocurrió un error al conectar con el asistente.",
                            "assistant"
                        );
                    }
                    finally {
                        sendButton.disabled = false;
                        chatInput.disabled = false;
                        chatInput.focus();
                    }
                });

            });
    </script>

</body>
