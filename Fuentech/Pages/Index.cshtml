@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Fuentech transforma procesos repetitivos en soluciones digitales con inteligencia artificial, automatización y software a la medida." />
    <title>Fuentech | Soluciones digitales para empresas</title>

    <style>
            :root {
                --navy: #0c1729;
                --navy-2: #101f35;
                --blue: #3b82f6;
                --blue-bright: #60a5fa;
                --ink: #142033;
                --muted: #68758a;
                --line: #e6ebf2;
                --pale: #f6f8fc;
                --white: #fff;
                --radius: 18px;
                --shadow: 0 18px 50px rgba(22, 41, 72, .08);
            }

            * {
                box-sizing: border-box;
            }

            html {
                scroll-behavior: smooth;
                scroll-padding-top: 90px;
            }

            body {
                margin: 0;
                color: var(--ink);
                background: #fff;
                font-family: "Segoe UI", Arial, sans-serif;
                line-height: 1.6;
                -webkit-font-smoothing: antialiased;
            }

            a {
                color: inherit;
                text-decoration: none;
            }

            .container {
                width: min(1160px, calc(100% - 48px));
                margin-inline: auto;
            }

            /* HEADER */

            .site-header {
                position: relative;
                z-index: 10;
                background: #fff;
                border-bottom: 1px solid #edf0f5;
            }

            .nav-container {
                min-height: 82px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 24px;
            }

            .brand {
                display: inline-flex;
                align-items: center;
                gap: 10px;
                flex-shrink: 0;
            }

            .brand-mark {
                display: grid;
                width: 39px;
                height: 39px;
                place-items: center;
                border-radius: 12px;
                background: linear-gradient(140deg, #4f91ff, #2563eb);
                box-shadow: 0 7px 16px rgba(37, 99, 235, .22);
            }

                .brand-mark svg {
                    width: 25px;
                    height: 25px;
                    fill: none;
                    stroke: #fff;
                    stroke-width: 1.7;
                    stroke-linecap: round;
                    stroke-linejoin: round;
                }

            .brand-name {
                font-size: 1.37rem;
                font-weight: 760;
                letter-spacing: -.055em;
                color: #101b2d;
            }

            .main-nav {
                display: flex;
                align-items: center;
                gap: 31px;
            }

            .nav-link {
                color: #596579;
                font-size: .91rem;
                font-weight: 550;
                transition: color .2s ease;
            }

                .nav-link:hover,
                .nav-link.active {
                    color: #2563eb;
                }

            .nav-cta {
                display: inline-flex;
                align-items: center;
                gap: 10px;
                padding: 11px 17px;
                color: #fff;
                background: var(--navy);
                border-radius: 10px;
                font-size: .9rem;
                font-weight: 650;
                transition: transform .2s ease, background .2s ease;
            }

                .nav-cta:hover {
                    transform: translateY(-1px);
                    background: #1c3456;
                }

            .nav-toggle,
            .nav-toggle-label {
                display: none;
            }

            /* HERO */

            .hero {
                position: relative;
                overflow: hidden;
                color: #fff;
                background: radial-gradient( ellipse at 72% 42%, #142a49 0, #0c1729 48%, #0a1424 100% );
            }

            .hero-grid {
                position: relative;
                z-index: 1;
                min-height: 570px;
                display: grid;
                grid-template-columns: 1.05fr .95fr;
                align-items: center;
                gap: 44px;
                padding-top: 58px;
                padding-bottom: 68px;
            }

            .hero-content {
                max-width: 620px;
                padding: 18px 0;
            }

            .eyebrow,
            .section-kicker {
                display: inline-flex;
                align-items: center;
                gap: 9px;
                color: #3d82f6;
                font-size: .72rem;
                line-height: 1.4;
                font-weight: 800;
                letter-spacing: .13em;
            }

            .eyebrow {
                color: #92bbff;
                margin-bottom: 21px;
            }

            .eyebrow-dot {
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: #60a5fa;
                box-shadow: 0 0 0 5px rgba(96, 165, 250, .12);
            }

            .hero h1 {
                margin: 0;
                color: #fff;
                font-size: clamp(2.65rem, 4.2vw, 4.35rem);
                font-weight: 760;
                line-height: 1.08;
                letter-spacing: -.064em;
            }

                .hero h1 span {
                    color: #75adff;
                }

            .hero-copy {
                max-width: 540px;
                margin: 23px 0 29px;
                color: #b8c5d8;
                font-size: 1.08rem;
                line-height: 1.8;
            }

            .hero-actions {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                gap: 12px;
            }

            .button {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 12px;
                min-height: 49px;
                padding: 12px 18px;
                border: 1px solid transparent;
                border-radius: 10px;
                font-size: .92rem;
                font-weight: 680;
                transition: transform .2s ease, background .2s ease, box-shadow .2s ease;
                cursor: pointer;
            }

                .button:hover {
                    transform: translateY(-2px);
                }

            .button-primary {
                color: #fff;
                background: #347cf2;
                box-shadow: 0 10px 25px rgba(37, 99, 235, .2);
            }

                .button-primary:hover {
                    background: #2563eb;
                    box-shadow: 0 13px 28px rgba(37, 99, 235, .3);
                }

            .button-secondary {
                color: #e4ebf6;
                border-color: #43536a;
                background: rgba(255, 255, 255, .025);
            }

                .button-secondary:hover {
                    background: rgba(255, 255, 255, .08);
                }

            .hero-note {
                display: flex;
                align-items: center;
                gap: 9px;
                margin-top: 27px;
                color: #91a2bb;
                font-size: .81rem;
            }

            .note-icon {
                color: #70aaff;
                font-size: 1.1rem;
            }

            .hero-glow {
                position: absolute;
                pointer-events: none;
                border-radius: 50%;
                filter: blur(2px);
            }

            .hero-glow-one {
                width: 430px;
                height: 430px;
                right: 5%;
                top: 2%;
                background: radial-gradient(circle, rgba(37, 99, 235, .13), transparent 68%);
            }

            .hero-glow-two {
                width: 290px;
                height: 290px;
                left: -150px;
                bottom: -170px;
                background: radial-gradient(circle, rgba(30, 64, 175, .16), transparent 70%);
            }

            .hero-bottom-line {
                position: absolute;
                right: 0;
                bottom: 0;
                left: 0;
                height: 1px;
                background: linear-gradient(90deg, transparent, rgba(96, 165, 250, .35), transparent);
            }

            /* HERO VISUAL */

            .hero-visual {
                position: relative;
                min-height: 400px;
                display: grid;
                place-items: center;
                isolation: isolate;
            }

            .visual-orbit {
                position: absolute;
                left: 50%;
                top: 50%;
                border: 1px solid rgba(130, 171, 235, .18);
                border-radius: 50%;
                transform: translate(-50%, -50%) rotate(-18deg);
            }

            .orbit-one {
                width: 370px;
                height: 270px;
            }

            .orbit-two {
                width: 285px;
                height: 365px;
                transform: translate(-50%, -50%) rotate(36deg);
                border-color: rgba(130, 171, 235, .12);
            }

            .visual-center {
                position: relative;
                z-index: 2;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                width: 192px;
                height: 192px;
                border: 1px solid rgba(130, 171, 235, .26);
                border-radius: 50%;
                background: radial-gradient(circle at 35% 25%, #1d3558, #0d1b30 72%);
                box-shadow: 0 0 0 13px rgba(68, 113, 181, .035), 0 0 70px rgba(37, 99, 235, .14);
            }

            .center-symbol {
                display: grid;
                width: 58px;
                height: 58px;
                place-items: center;
                margin-bottom: 9px;
                border-radius: 17px;
                background: linear-gradient(145deg, #4b91ff, #2762ce);
                box-shadow: 0 10px 24px rgba(37, 99, 235, .3);
            }

                .center-symbol svg {
                    width: 35px;
                    height: 35px;
                    fill: none;
                    stroke: #fff;
                    stroke-width: 1.65;
                    stroke-linecap: round;
                    stroke-linejoin: round;
                }

            .visual-center strong {
                color: #fff;
                font-size: 1.17rem;
                letter-spacing: -.04em;
            }

            .visual-center > span {
                margin-top: 2px;
                color: #a5b6cd;
                font-size: .68rem;
            }

            .floating-card {
                position: absolute;
                z-index: 3;
                display: flex;
                align-items: center;
                gap: 11px;
                min-width: 220px;
                padding: 12px 14px;
                border: 1px solid rgba(171, 194, 226, .15);
                border-radius: 13px;
                background: rgba(19, 35, 58, .92);
                box-shadow: 0 16px 40px rgba(0, 0, 0, .18);
                backdrop-filter: blur(14px);
            }

                .floating-card strong,
                .floating-card small {
                    display: block;
                    white-space: nowrap;
                }

                .floating-card strong {
                    color: #edf4ff;
                    font-size: .77rem;
                    font-weight: 680;
                }

                .floating-card small {
                    margin-top: 2px;
                    color: #8fa3bf;
                    font-size: .66rem;
                }

            .floating-card-top {
                top: 35px;
                right: -5px;
            }

            .floating-card-left {
                top: 178px;
                left: -14px;
            }

            .floating-card-bottom {
                right: 0;
                bottom: 25px;
            }

            .mini-icon {
                display: grid;
                width: 35px;
                height: 35px;
                flex-shrink: 0;
                place-items: center;
                border-radius: 10px;
                font-size: 1.18rem;
                font-weight: 700;
            }

            .mini-icon-blue {
                color: #8fc0ff;
                background: rgba(59, 130, 246, .17);
            }

            .mini-icon-purple {
                color: #c4b5fd;
                background: rgba(139, 92, 246, .17);
            }

            .mini-icon-cyan {
                color: #8ae5f6;
                background: rgba(6, 182, 212, .16);
            }

            .status-dot {
                width: 7px;
                height: 7px;
                margin-left: auto;
                flex-shrink: 0;
                border-radius: 50%;
                background: #4ade80;
                box-shadow: 0 0 0 4px rgba(74, 222, 128, .1);
            }

            .visual-spark {
                position: absolute;
                color: #7db1ff;
            }

            .spark-one {
                top: 90px;
                left: 26%;
                font-size: 1.15rem;
            }

            .spark-two {
                right: 18%;
                bottom: 80px;
                font-size: 1.4rem;
            }

            /* BARRA DE CATEGORÍAS */

            .trust-strip {
                background: #fff;
                border-bottom: 1px solid #edf1f6;
            }

            .trust-inner {
                min-height: 79px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 20px;
                color: #4f5d72;
                font-size: .85rem;
            }

                .trust-inner > span {
                    color: #8b97a9;
                    font-size: .69rem;
                    font-weight: 800;
                    letter-spacing: .12em;
                }

            .trust-check {
                margin-right: 6px;
                color: #347cf2;
                font-weight: 800;
            }

            /* SECCIONES GENERALES */

            .section {
                padding: 96px 0;
            }

            .section-heading {
                max-width: 680px;
                margin-bottom: 43px;
            }

            .centered-heading {
                margin-inline: auto;
                text-align: center;
            }

            .section-heading h2,
            .services-copy h2 {
                margin: 12px 0 14px;
                color: #142033;
                font-size: clamp(2rem, 3.3vw, 2.8rem);
                line-height: 1.17;
                letter-spacing: -.055em;
                font-weight: 760;
            }

                .section-heading h2 span,
                .services-copy h2 span {
                    color: #347cf2;
                }

            .section-heading p,
            .services-copy > p {
                margin: 0;
                color: var(--muted);
                font-size: 1rem;
                line-height: 1.8;
            }

            /* SOLUCIONES */

            .solutions-section {
                background: #fff;
            }

            .solution-grid {
                display: grid;
                grid-template-columns: repeat(4, minmax(0, 1fr));
                gap: 18px;
            }

            .solution-card {
                min-height: 310px;
                padding: 25px 22px 22px;
                border: 1px solid var(--line);
                border-radius: var(--radius);
                background: #fff;
                box-shadow: 0 6px 23px rgba(22, 41, 72, .025);
                transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease;
            }

                .solution-card:hover {
                    transform: translateY(-5px);
                    border-color: #c9dafa;
                    box-shadow: var(--shadow);
                }

            .solution-icon {
                display: grid;
                width: 49px;
                height: 49px;
                place-items: center;
                margin-bottom: 22px;
                border-radius: 14px;
            }

                .solution-icon svg {
                    width: 25px;
                    height: 25px;
                    fill: none;
                    stroke: currentColor;
                    stroke-width: 1.65;
                    stroke-linecap: round;
                    stroke-linejoin: round;
                }

            .icon-blue {
                color: #357bf0;
                background: #eaf2ff;
            }

            .icon-purple {
                color: #7c5ce0;
                background: #f1edff;
            }

            .icon-cyan {
                color: #0891b2;
                background: #e5f9fc;
            }

            .icon-green {
                color: #15976b;
                background: #e5f8ef;
            }

            .card-label {
                margin-bottom: 8px;
                color: #8591a3;
                font-size: .62rem;
                font-weight: 800;
                letter-spacing: .09em;
            }

            .solution-card h3 {
                margin: 0 0 9px;
                color: #1a263a;
                font-size: 1.1rem;
                letter-spacing: -.025em;
            }

            .solution-card p {
                min-height: 84px;
                margin: 0 0 17px;
                color: #6a778b;
                font-size: .86rem;
                line-height: 1.7;
            }

            .text-link {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                color: #2563eb;
                font-size: .86rem;
                font-weight: 700;
            }

                .text-link span {
                    transition: transform .2s ease;
                }

                .text-link:hover span {
                    transform: translateX(4px);
                }

            /* SERVICIOS */

            .services-section {
                background: #f6f8fc;
            }

            .services-grid {
                display: grid;
                grid-template-columns: .88fr 1.12fr;
                gap: 85px;
                align-items: center;
            }

            .services-copy h2 {
                max-width: 490px;
                margin-top: 14px;
            }

            .services-copy > p {
                max-width: 500px;
                margin-bottom: 26px;
            }

            .button-dark {
                color: #fff;
                background: #12213a;
            }

                .button-dark:hover {
                    background: #223b5f;
                }

            .service-list {
                border-top: 1px solid #dfe6f0;
            }

            .service-item {
                display: grid;
                grid-template-columns: 38px 1fr 24px;
                gap: 16px;
                align-items: start;
                padding: 24px 0;
                border-bottom: 1px solid #dfe6f0;
            }

            .service-number {
                padding-top: 2px;
                color: #347cf2;
                font-size: .8rem;
                font-weight: 800;
            }

            .service-item h3 {
                margin: 0 0 6px;
                color: #1b293e;
                font-size: 1rem;
            }

            .service-item p {
                margin: 0;
                color: #718096;
                font-size: .87rem;
                line-height: 1.65;
            }

            .service-arrow {
                color: #7f8ca0;
                font-size: 1.1rem;
            }

            /* CÓMO FUNCIONA */

            .process-section {
                background: #fff;
            }

            .process-grid {
                display: grid;
                grid-template-columns: repeat(3, minmax(0, 1fr));
                gap: 40px;
            }

            .process-step {
                position: relative;
                padding: 26px 25px 25px;
                border: 1px solid var(--line);
                border-radius: 16px;
                background: #fff;
            }

            .process-number {
                display: grid;
                width: 43px;
                height: 43px;
                place-items: center;
                margin-bottom: 20px;
                border-radius: 12px;
                color: #2563eb;
                background: #eaf2ff;
                font-size: .84rem;
                font-weight: 800;
            }

            .process-step h3 {
                margin: 0 0 8px;
                color: #1b293e;
                font-size: 1.03rem;
            }

            .process-step p {
                margin: 0;
                color: #718096;
                font-size: .9rem;
                line-height: 1.75;
            }

            /* ==========================
                                   NUEVA SECCIÓN DE CONTACTO
                                ========================== */

            .contact-section {
                padding: 90px 0;
                background: #f6f8fc;
            }

            .contact-layout {
                display: grid;
                grid-template-columns: .9fr 1.1fr;
                gap: 65px;
                align-items: start;
            }

            /* Información de contacto */

            .contact-info {
                padding-top: 14px;
            }

                .contact-info h2 {
                    max-width: 470px;
                    margin: 15px 0 17px;
                    color: #142033;
                    font-size: clamp(2.1rem, 3.5vw, 3rem);
                    line-height: 1.15;
                    letter-spacing: -.055em;
                }

                    .contact-info h2 span {
                        color: #347cf2;
                    }

            .contact-description {
                max-width: 460px;
                margin: 0 0 32px;
                color: #68758a;
                font-size: 1rem;
                line-height: 1.8;
            }

            .contact-details {
                display: flex;
                flex-direction: column;
                gap: 14px;
            }

            .contact-method {
                display: flex;
                align-items: center;
                gap: 15px;
                padding: 17px;
                border: 1px solid #e3e9f2;
                border-radius: 14px;
                background: #fff;
                transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
            }

                .contact-method:hover {
                    transform: translateY(-3px);
                    border-color: #bfd5fa;
                    box-shadow: 0 10px 25px rgba(22, 41, 72, .06);
                }

            .contact-method-icon {
                display: grid;
                width: 47px;
                height: 47px;
                flex-shrink: 0;
                place-items: center;
                border-radius: 13px;
                color: #347cf2;
                background: #eaf2ff;
            }

                .contact-method-icon svg {
                    width: 23px;
                    height: 23px;
                    fill: none;
                    stroke: currentColor;
                    stroke-width: 1.8;
                    stroke-linecap: round;
                    stroke-linejoin: round;
                }

            .contact-method-text {
                display: flex;
                flex-direction: column;
                min-width: 0;
            }

                .contact-method-text small {
                    margin-bottom: 3px;
                    color: #8190a5;
                    font-size: .76rem;
                }

                .contact-method-text strong {
                    color: #17253a;
                    font-size: .98rem;
                    font-weight: 700;
                    overflow-wrap: anywhere;
                }

            .contact-method-arrow {
                margin-left: auto;
                color: #93a1b4;
                font-size: 1.1rem;
            }

            .contact-info-note {
                display: flex;
                align-items: flex-start;
                gap: 10px;
                margin-top: 25px;
                padding: 15px;
                border-radius: 12px;
                background: #eaf2ff;
                color: #4e6383;
                font-size: .84rem;
                line-height: 1.6;
            }

                .contact-info-note span {
                    color: #347cf2;
                    font-size: 1.1rem;
                }

            /* Formulario */

            .contact-form-card {
                padding: 34px;
                border: 1px solid #e6ebf2;
                border-radius: 20px;
                background: #fff;
                box-shadow: 0 15px 45px rgba(22, 41, 72, .06);
            }

            .contact-form-header {
                margin-bottom: 26px;
            }

                .contact-form-header h3 {
                    margin: 0 0 7px;
                    color: #142033;
                    font-size: 1.48rem;
                    letter-spacing: -.035em;
                }

                .contact-form-header p {
                    margin: 0;
                    color: #78869a;
                    font-size: .88rem;
                    line-height: 1.6;
                }

            .contact-form {
                display: flex;
                flex-direction: column;
                gap: 18px;
            }

            .form-group {
                display: flex;
                flex-direction: column;
                gap: 7px;
            }

                .form-group label {
                    color: #29374c;
                    font-size: .85rem;
                    font-weight: 650;
                }

                    .form-group label .required {
                        color: #347cf2;
                    }

                    .form-group label .optional {
                        color: #8b97a9;
                        font-size: .76rem;
                        font-weight: 400;
                    }

            .form-control {
                width: 100%;
                min-height: 47px;
                padding: 12px 14px;
                border: 1px solid #dce3ed;
                border-radius: 10px;
                outline: none;
                background: #fff;
                color: #17253a;
                font-family: inherit;
                font-size: .9rem;
                transition: border-color .2s ease, box-shadow .2s ease;
            }

                .form-control::placeholder {
                    color: #a2adbc;
                }

                .form-control:focus {
                    border-color: #5792f5;
                    box-shadow: 0 0 0 3px rgba(59, 130, 246, .11);
                }

                .form-control[aria-invalid="true"] {
                    border-color: #dc5656;
                }

            textarea.form-control {
                min-height: 130px;
                resize: vertical;
            }

            .form-contact-row {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 14px;
            }

            .form-hint {
                margin: -9px 0 0;
                color: #8290a3;
                font-size: .75rem;
            }

            .form-error {
                display: none;
                color: #c43d3d;
                font-size: .78rem;
            }

                .form-error.visible {
                    display: block;
                }

            .form-submit {
                width: 100%;
                min-height: 51px;
                border: none;
                color: #fff;
                background: #347cf2;
                box-shadow: 0 8px 20px rgba(37, 99, 235, .17);
            }

                .form-submit:hover {
                    background: #2563eb;
                }

