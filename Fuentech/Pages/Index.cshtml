            /* ==========================
                           CHATBOT FUENTECH
                        ========================== */

            .fc-chat-launcher {
                position: fixed;
                right: 26px;
                bottom: 24px;
                z-index: 1000;
                width: 60px;
                height: 60px;
                display: grid;
                place-items: center;
                border: none;
                border-radius: 50%;
                color: #fff;
                background: #347cf2;
                box-shadow: 0 8px 25px rgba(37, 99, 235, .35);
                cursor: pointer;
                transition: transform .2s ease, background .2s ease;
            }

                .fc-chat-launcher:hover {
                    transform: translateY(-3px);
                    background: #2563eb;
                }

                .fc-chat-launcher svg {
                    width: 27px;
                    height: 27px;
                    fill: none;
                    stroke: currentColor;
                    stroke-width: 1.8;
                    stroke-linecap: round;
                    stroke-linejoin: round;
                }

            .fc-chat-panel {
                position: fixed;
                right: 26px;
                bottom: 98px;
                z-index: 1000;
                width: min(380px, calc(100vw - 32px));
                height: min(560px, calc(100vh - 120px));
                display: none;
                flex-direction: column;
                overflow: hidden;
                border: 1px solid #e2e8f0;
                border-radius: 19px;
                background: #fff;
                box-shadow: 0 20px 65px rgba(12, 23, 41, .2);
            }

                .fc-chat-panel.open {
                    display: flex;
                }

            .fc-chat-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                padding: 17px 19px;
                color: #fff;
                background: #0c1729;
            }

            .fc-chat-brand {
                display: flex;
                align-items: center;
                gap: 11px;
            }

            .fc-chat-avatar {
                display: grid;
                width: 39px;
                height: 39px;
                place-items: center;
                border-radius: 12px;
                color: #fff;
                background: #347cf2;
                font-weight: 800;
            }

            .fc-chat-brand strong,
            .fc-chat-brand small {
                display: block;
            }

            .fc-chat-brand strong {
                font-size: .95rem;
            }

            .fc-chat-brand small {
                margin-top: 2px;
                color: #aebed3;
                font-size: .72rem;
            }

            .fc-chat-close {
                display: grid;
                width: 34px;
                height: 34px;
                place-items: center;
                border: none;
                border-radius: 9px;
                color: #dce6f5;
                background: transparent;
                font-size: 1.4rem;
                cursor: pointer;
            }

                .fc-chat-close:hover {
                    background: rgba(255, 255, 255, .1);
                }

            .fc-chat-messages {
                flex: 1;
                display: flex;
                flex-direction: column;
                gap: 13px;
                overflow-y: auto;
                padding: 19px 15px;
                background: #f6f8fc;
            }

            .fc-message {
                display: flex;
                flex-direction: column;
                max-width: 88%;
            }

                .fc-message.user {
                    align-self: flex-end;
                    align-items: flex-end;
                }

                .fc-message.assistant {
                    align-self: flex-start;
                    align-items: flex-start;
                }

            .fc-bubble {
                padding: 11px 14px;
                border-radius: 14px;
                font-size: .86rem;
                line-height: 1.6;
                overflow-wrap: anywhere;
                white-space: pre-wrap;
            }

            .fc-message.user .fc-bubble {
                color: #fff;
                background: #347cf2;
                border-bottom-right-radius: 4px;
            }

            .fc-message.assistant .fc-bubble {
                color: #25344a;
                background: #fff;
                border: 1px solid #e7ecf3;
                border-bottom-left-radius: 4px;
            }

            .fc-chat-input-area {
                padding: 13px;
                border-top: 1px solid #e9edf3;
                background: #fff;
            }

            .fc-chat-form {
                display: flex;
                align-items: center;
                gap: 9px;
            }

            .fc-chat-input {
                width: 100%;
                min-width: 0;
                height: 43px;
                padding: 0 13px;
                border: 1px solid #dce3ed;
                border-radius: 11px;
                outline: none;
                color: #17253a;
                background: #f9fafc;
                font-family: inherit;
                font-size: .85rem;
            }

                .fc-chat-input:focus {
                    border-color: #5792f5;
                    box-shadow: 0 0 0 3px rgba(59, 130, 246, .1);
                }

            .fc-chat-send {
                display: grid;
                width: 43px;
                height: 43px;
                flex-shrink: 0;
                place-items: center;
                border: none;
                border-radius: 11px;
                color: #fff;
                background: #347cf2;
                cursor: pointer;
                transition: background .2s ease;
            }

                .fc-chat-send:hover {
                    background: #2563eb;
                }

                .fc-chat-send:disabled {
                    opacity: .55;
                    cursor: not-allowed;
                }

                .fc-chat-send svg {
                    width: 19px;
                    height: 19px;
                    fill: none;
                    stroke: currentColor;
                    stroke-width: 2;
                    stroke-linecap: round;
                    stroke-linejoin: round;
                }

            .fc-chat-disclaimer {
                margin: 9px 0 0;
                color: #929eaf;
                font-size: .67rem;
                text-align: center;
            }
            /* CORRECCIÓN DE TEXTO DEL CHATBOT */

            .fc-chat-panel .fc-message,
            .fc-chat-panel .fc-bubble,
            .fc-chat-panel .fc-bubble * {
                text-align: left !important;
                text-align-last: left !important;
                word-spacing: normal !important;
                letter-spacing: normal;
            }

            .fc-chat-panel .fc-bubble {
                white-space: pre-wrap;
                overflow-wrap: anywhere;
                line-height: 1.6;
            }

                .fc-chat-panel .fc-bubble p {
                    margin: 0 0 10px 0;
                }

                    .fc-chat-panel .fc-bubble p:last-child {
                        margin-bottom: 0;
                    }
    </style>
</head>

