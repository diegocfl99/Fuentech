@page
@model Fuentech.Pages.Admin.IndexModel
@{
    Layout = null;
    ViewData["Title"] = "Solicitudes | Fuentech";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Administración | Fuentech</title>

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                background: #f3f6fb;
                font-family: Arial, sans-serif;
                color: #14213d;
            }

            header {
                background: #14213d;
                color: white;
                padding: 20px 5%;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .logo {
                font-size: 25px;
                font-weight: bold;
            }

                .logo span {
                    color: #3985ff;
                }

            .logout {
                color: white;
                text-decoration: none;
                background: #2878f0;
                padding: 10px 16px;
                border-radius: 7px;
                font-size: 13px;
            }

            main {
                max-width: 1200px;
                margin: 40px auto;
                padding: 0 20px;
            }

            .heading {
                display: flex;
                justify-content: space-between;
                align-items: center;
                flex-wrap: wrap;
                gap: 15px;
                margin-bottom: 25px;
            }

            h1 {
                margin: 0 0 8px;
                font-size: 28px;
            }

            .subtitle {
                color: #718096;
                margin: 0;
                font-size: 14px;
            }

            .counter {
                background: white;
                padding: 15px 22px;
                border-radius: 10px;
                box-shadow: 0 3px 12px rgba(0,0,0,.04);
            }

                .counter strong {
                    display: block;
                    color: #2878f0;
                    font-size: 25px;
                }

                .counter span {
                    font-size: 12px;
                    color: #718096;
                }

            .table-container {
                background: white;
                border-radius: 12px;
                overflow-x: auto;
                box-shadow: 0 4px 18px rgba(0,0,0,.04);
            }

            table {
                width: 100%;
                border-collapse: collapse;
                min-width: 850px;
            }

            th, td {
                text-align: left;
                padding: 17px 15px;
                border-bottom: 1px solid #edf0f5;
                font-size: 13px;
                vertical-align: top;
            }

            th {
                background: #f8faff;
                color: #718096;
                font-size: 12px;
            }

            td {
                color: #334155;
            }

            .message {
                max-width: 300px;
                white-space: pre-wrap;
                overflow-wrap: anywhere;
            }

            .date {
                white-space: nowrap;
            }

            .delete-button {
                border: none;
                background: #fff0ef;
                color: #d93025;
                padding: 9px 12px;
                border-radius: 6px;
                cursor: pointer;
                font-weight: bold;
            }

                .delete-button:hover {
                    background: #ffe0dd;
                }

            .empty {
                text-align: center;
                padding: 50px 20px;
                color: #718096;
            }

                .empty strong {
                    display: block;
                    color: #14213d;
                    margin-bottom: 8px;
                    font-size: 17px;
                }

            footer {
                text-align: center;
                color: #94a3b8;
                font-size: 12px;
                padding: 30px;
            }

            @@media (max-width: 600px) {
                main {
                    margin-top: 25px;
                }

                h1 {
                    font-size: 23px;
                }

                header {
                    padding: 18px 20px;
                }
            }
    </style>
</head>

<body>
    <header>
        <div class="logo">Fuente<span>ch</span></div>
        <a class="logout" href="/Admin/Logout">Cerrar sesión</a>
    </header>

    <main>
        <div class="heading">
            <div>
                <h1>Solicitudes de contacto</h1>
                <p class="subtitle">
                    Administra los proyectos enviados desde tu sitio web.
                </p>
            </div>

            <div class="counter">
                <strong>@Model.Solicitudes.Count</strong>
                <span>Solicitudes recibidas</span>
            </div>
        </div>

        <div class="table-container">
            @if (Model.Solicitudes.Count == 0)
            {
                <div class="empty">
                    <strong>No hay solicitudes todavía</strong>
                    Cuando alguien envíe el formulario, aparecerá aquí.
                </div>
            }
            else
            {
                <table>
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>Teléfono</th>
                            <th>Proyecto</th>
                            <th>Fecha</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var solicitud in Model.Solicitudes)
                        {
                            <tr>
                                <td><strong>@solicitud.Nombre</strong></td>
                                <td>@(solicitud.Correo ?? "No proporcionado")</td>
                                <td>@(solicitud.Telefono ?? "No proporcionado")</td>
                                <td class="message">@solicitud.Mensaje</td>
                                <td class="date">
                                    @solicitud.Fecha.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td>
                                    <form method="post"
                                          asp-page-handler="Eliminar"
                                          onsubmit="return confirm('¿Seguro que deseas eliminar esta solicitud?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@solicitud.Id" />
                                        <button type="submit" class="delete-button">
                                            Eliminar
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </main>

    <footer>Fuentech © 2026 | Panel de administración</footer>
</body>
</html>
